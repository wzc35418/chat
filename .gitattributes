# 统一换行，避免 Windows/Linux 之间来回改写
* text=auto

# 二进制资源明确标注，避免被当作文本做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.aar binary
*.so binary
*.dll binary
*.exe binary
*.db binary
*.db-wal binary
*.db-shm binary

# 脚本按平台固定换行
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.md text eol=lf
