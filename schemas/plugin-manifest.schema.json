{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat trusted JVM plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "sdkVersion",
    "runtime",
    "entrypoint",
    "platforms",
    "requestedCapabilities",
    "contributions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*){2,}$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sdkVersion": {
      "const": "1"
    },
    "runtime": {
      "const": "trusted-jvm"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$",
      "maxLength": 256
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows-x64",
          "linux-x64"
        ]
      }
    },
    "requestedCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "enum": [
          "commands.register",
          "messages.selected.read",
          "messages.draft.propose",
          "settings.own"
        ]
      }
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "commands",
          "message-actions",
          "settings"
        ]
      }
    },
    "jarSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
