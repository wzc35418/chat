{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "schemaVersion",
    "operationId",
    "objectId",
    "payload",
    "fallbackText"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 128
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 65536
    },
    "fallbackText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
