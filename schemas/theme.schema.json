{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "colors"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "const": 1
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "text",
        "accent"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[A-Fa-f0-9]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[A-Fa-f0-9]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[A-Fa-f0-9]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[A-Fa-f0-9]{6}$"
        }
      }
    }
  }
}
